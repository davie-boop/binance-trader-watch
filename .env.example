# 复制为 .env 后填写
TW_KOPYON_API_KEY=your_key_here
TW_KOPYON_BASE_URL=https://api.kopyon.com/v5/binance-copy-trading

# 交易员 portfolio id，从 https://www.binance.com/zh-CN/copy-trading/lead-details?portfolioId=xxx 获取
TW_TRADER_IDS=5231135285416047873

# 轮询间隔（秒）。跟单持仓约 5 分钟刷新一次，60 秒足够。
TW_POLL_INTERVAL=60

# SQLite 路径
TW_DB_PATH=data/trader_positions.db

# ===== 微信通知（可选）=====
# 渠道：pushplus（推荐）/ serverchan / wecom；留空表示不推送
TW_NOTIFY_CHANNEL=
# true=有新记录才推送；false=每次抓取都推送最新 N 条
TW_NOTIFY_ONLY_NEW=true
# PushPlus token：https://www.pushplus.plus/ 微信扫码登录后在「一对一推送」复制
TW_PUSHPLUS_TOKEN=
# Server酱 SendKey：https://sct.ftqq.com/ （免费版每天 5 条）
TW_SERVERCHAN_KEY=
# 企业微信群机器人 webhook 里的 key
TW_WECOM_WEBHOOK_KEY=
